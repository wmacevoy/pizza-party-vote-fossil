# Pinned upstream version metadata for this repo's own build steps.
#
# The Fossil / SQLCipher / LibreSSL pins used to live here, but that whole
# build moved into the shared fossil-see project (vendor/fossil-see,
# https://github.com/wmacevoy/fossil-sqlcipher-libressl). Its pins now live
# in vendor/fossil-see/build/versions.env; the exact commit this repo
# consumes is whatever vendor/fossil-see is pinned to as a git submodule
# (see .gitmodules / `git submodule status`), bumped the normal submodule way:
#   cd vendor/fossil-see && git fetch && git checkout <new-ref> && cd ../..
#   git add vendor/fossil-see
#   git commit -m "Bump fossil-see to <new-ref>"

# ── QuickJS (CLI runtime; not linked into Fossil) ─────────────────
# Source: github.com/bellard/quickjs (submodule: vendor/quickjs)
# Branch: master at pin time (Bellard does not tag releases)
# Last commit subject: "new release"
QUICKJS_REF=3d5e064e9dd67c70f7962836505a7fa067bf0a4e
QUICKJS_DATE=2026-06-04
